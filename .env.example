# Gemini API key (isi di .env.local, jangan commit nilai rahasia)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=

# Batas panggilan logis LLM per video per run (default 20)
MGS_LLM_BUDGET_PER_RUN=20

# Batas kuota harian Gemini (opsional, untuk cek pra-run)
GEMINI_RPD_LIMIT=
